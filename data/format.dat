# lines beggining with # are treated as comments
## T: int, Tplus: int
T T^+
# production periods
## setup_cost: vector[double]
cS_1 cS_2 ... cS_T
## production_cost: vector[double]
cP_1 cP_2 ... cP_T
## production_capacity: vector[double]
C_1 C_2 ... C_T
# lead time
## common_lead_time: int
\hat{l}
## late_deviation: vector[int]
\zeta^+_1 \zeta^+_2 ... \zeta^+_T
## early_deviation: vector[int]
\zeta^-_1 \zeta^-_2 ... \zeta^-_T
# future periods
## demand: vector[double]
d_{T+1} d_{T+2} ... d_{T^+}
## inventory_cost: vector[double]
cI_{T+1} cI_{T+2} ... cI_{T^+}
## backordering_cost: vector[double]
cB_{T+1} cB_{T+2} ... cB_{T^+}
# uncertainty modelling
# UNC_TYPE ::= NONE | INTERVAL | GAMMAD Gamma | GammaC Gamma
# e.g.
# NONE
# INTERVAL
# GAMMAD 3
# GAMMAC 4
UNC_TYPE GAMMA?
# R* BOUND
# RBOUND := NONE | R* bound
R* b
